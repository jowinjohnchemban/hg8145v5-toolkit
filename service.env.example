# Copy to service.env on the modem (beside service.sh). Plain KEY=value, no secrets here.
# Every line is optional; with no file the DNS filter and other extras stay off.
# See docs/dns-filter.md for the full list.

# Transparent mode (recommended): every DNS query from the LAN (port 53, IPv4 and IPv6) is redirected to the
# filter, whatever resolver the device was told to use. Nothing address-specific is needed:
# the LAN bridge, its address and the upstream are all detected at runtime,
# so changing the LAN IP, DHCP DNS or WAN settings in the modem GUI does not break it. If the
# filter stops answering, the redirect is removed within about 1.5 seconds and DNS goes straight
# back to the resolver each device was using.
FILTER_TAKEOVER=on

# Block lists, comma-separated; they are combined. Hosts files and uBlock/ABP domain rules both work.
# Hagezi publishes tiers (adblock/light.txt, multi.txt, pro.txt, ...): see docs/dns-filter.md.
# Downloaded into RAM only, never saved to flash.
FILTER_LISTS=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts,https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock/multi.txt,https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/badware.txt,https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/filters.txt,https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/privacy.txt,https://malware-filter.gitlab.io/malware-filter/urlhaus-filter-hosts.txt

FILTER_REFRESH_HOURS=24

# Optional overrides (normally leave unset):
#FILTER_PORT=5335         # local listen port, if 5335 ever clashes
#FILTER_IFACE=br0          # LAN bridge name, if it is not the first br*
#FILTER_UPSTREAM=ip        # fixed upstream instead of the modem's own resolver
#FILTER_MODE=nxdomain
#FILTER_DENY_FILE=/mnt/jffs2/hg8145v5-mcp/deny.txt
#FILTER_ALLOW_FILE=/mnt/jffs2/hg8145v5-mcp/allow.txt
#FILTER_REGEX_DENY_FILE=/mnt/jffs2/hg8145v5-mcp/deny.regex    # one regex per line, matched on the full name
#FILTER_REGEX_ALLOW_FILE=/mnt/jffs2/hg8145v5-mcp/allow.regex
